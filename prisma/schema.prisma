generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
}

enum NewsCategory {
  ADMINISTRATIVE
  SCIENTIFIC
  ACTIVITIES
  ANNOUNCEMENTS
}

model contact_messages {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  full_name  String   @db.VarChar(120)
  email      String   @db.VarChar(120)
  phone      String?  @db.VarChar(30)
  subject    String?  @db.VarChar(200)
  message    String
  status     String   @default("new") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model AdminUser {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email         String    @unique @db.VarChar(120)
  password_hash String
  role          AdminRole @default(ADMIN)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@map("admin_users")
}

model Media {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  filename   String   @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(120)
  size       Int
  data       Bytes
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  newsCoverFor      News[] @relation("NewsCoverImage")
  newsSecondaryFor  News[] @relation("NewsSecondaryImage")
  newsSecondary2For News[] @relation("NewsSecondaryImage2")
  deptFeeCardFor    DepartmentFee[] @relation("DeptFeeCardImage")

  @@map("media")
}

model News {
  id                String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title             String        @db.VarChar(250)
  titleEn           String?       @map("title_en") @db.VarChar(250)
  slug              String?       @unique @db.VarChar(250)
  excerpt           String?       @db.VarChar(500)
  excerptEn         String?       @map("excerpt_en") @db.VarChar(500)
  content           String
  contentEn         String?       @map("content_en") @db.Text
  category          NewsCategory?
  published         Boolean       @default(false) @map("is_published")
  publishedAt       DateTime?     @map("publish_date") @db.Timestamptz(6)
  featured          Boolean       @default(false)
  coverImageId      String?       @map("cover_image_id") @db.Uuid
  coverImage        Media?        @relation("NewsCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  secondaryImageId  String?       @map("secondary_image_id") @db.Uuid
  secondaryImage    Media?        @relation("NewsSecondaryImage", fields: [secondaryImageId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  secondaryImage2Id String?       @map("secondary_image2_id") @db.Uuid
  secondaryImage2   Media?        @relation("NewsSecondaryImage2", fields: [secondaryImage2Id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  // الحفاظ على العمود الموجود حالياً (اختياري)
  createdById String? @map("created_by") @db.Uuid
  createdBy   users?  @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([published, publishedAt])
  @@index([category])
  @@map("news")
}

model sessions {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id             String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  username       String     @unique @db.VarChar(50)
  email          String     @unique @db.VarChar(120)
  password_hash  String?
  password_plain String?
  role           String     @default("user") @db.VarChar(20)
  is_active      Boolean    @default(true)
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @default(now()) @db.Timestamptz(6)
  news           News[]
  sessions       sessions[]
}

model visitor_count {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  count      BigInt   @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model TickerItem {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  text       String   @db.VarChar(400)
  textEn     String?  @map("text_en") @db.VarChar(400)
  link       String?  @db.VarChar(500)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("ticker_items")
}

model DepartmentFee {
  id                   String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  department_slug      String           @unique @map("department_slug") @db.VarChar(120)
  display_name         String?          @map("display_name") @db.VarChar(250)
  display_name_en      String?          @map("display_name_en") @db.VarChar(250)
  categories           Json             @default("[]") @map("categories")
  cardImageId          String?          @map("card_image_id") @db.Uuid
  brief                String?          @db.Text
  brief_en             String?          @map("brief_en") @db.Text
  morning_price        Decimal          @map("morning_price") @db.Decimal(14, 0)
  evening_price        Decimal          @map("evening_price") @db.Decimal(14, 0)
  currency             String           @default("د.ع") @db.VarChar(20)
  registration_fee     Decimal?         @map("registration_fee") @db.Decimal(14, 0)
  extra_fees           String?          @map("extra_fees") @db.Text
  extra_fees_en        String?          @map("extra_fees_en") @db.Text
  fees_notes           String?          @map("fees_notes") @db.Text
  fees_notes_en        String?          @map("fees_notes_en") @db.Text
  morning_min_gpa      Decimal          @map("morning_min_gpa") @db.Decimal(5, 2)
  evening_min_gpa      Decimal          @map("evening_min_gpa") @db.Decimal(5, 2)
  admission_notes      String?          @map("admission_notes") @db.Text
  admission_notes_en   String?          @map("admission_notes_en") @db.Text
  show_apply_button    Boolean          @default(true) @map("show_apply_button")
  apply_types          Json             @default("[]") @map("apply_types")
  apply_url            String?          @map("apply_url") @db.Text
  apply_url_external   String?          @map("apply_url_external") @db.Text
  apply_url_whatsapp  String?          @map("apply_url_whatsapp") @db.Text
  apply_button_text    String?          @map("apply_button_text") @db.VarChar(120)
  apply_button_text_en String?          @map("apply_button_text_en") @db.VarChar(120)
  required_docs        Json?            @map("required_docs")
  application_start    DateTime?        @map("application_start") @db.Date
  application_end      DateTime?        @map("application_end") @db.Date
  featured             Boolean          @default(false)
  sort_order           Int              @default(0) @map("sort_order")
  is_active            Boolean          @default(true) @map("is_active")
  created_at           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cardImage           Media?           @relation("DeptFeeCardImage", fields: [cardImageId], references: [id], onDelete: SetNull)

  @@index([is_active, featured, sort_order])
  @@map("department_fees")
}

model Program {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug              String    @unique @db.VarChar(120)
  nameAr            String?   @map("name_ar") @db.VarChar(250)
  nameEn            String?   @map("name_en") @db.VarChar(250)
  briefAr           String?   @map("brief_ar") @db.Text
  briefEn           String?   @map("brief_en") @db.Text
  lecturesTables    Json      @default("[]") @map("lectures_tables")
  examsTables       Json      @default("[]") @map("exams_tables")
  studyShift        String   @map("study_shift") @db.VarChar(20)
  image1Id          String?   @map("image_1_id") @db.Uuid
  image2Id          String?   @map("image_2_id") @db.Uuid
  image3Id          String?   @map("image_3_id") @db.Uuid
  image4Id          String?   @map("image_4_id") @db.Uuid
  sortOrder         Int      @default(0) @map("sort_order")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("programs")
}
