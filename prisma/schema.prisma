generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  MANAGER
  EDITOR
  VIEWER
  EXAM_COMMITTEE
  ACCOUNTS
}

enum NewsCategory {
  ADMINISTRATIVE
  SCIENTIFIC
  ACTIVITIES
  ANNOUNCEMENTS
}

model contact_messages {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  full_name  String   @db.VarChar(120)
  email      String   @db.VarChar(120)
  phone      String?  @db.VarChar(30)
  subject    String?  @db.VarChar(200)
  message    String
  status     String   @default("new") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model AdminUser {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email         String    @unique @db.VarChar(120)
  password_hash String
  role          AdminRole @default(ADMIN)
  full_name     String?   @map("full_name") @db.VarChar(200)
  custom_url    String?   @map("custom_url") @db.VarChar(200)
  is_active     Boolean   @default(true) @map("is_active")
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  permissions   AdminUserPermission[]
  pagePermissions AdminPagePermission[]
  studentUpdater Student[] @relation("StudentUpdater")
  studentClearanceUpdater Student[] @relation("StudentClearanceUpdater")
  resultUploader Result[] @relation("ResultUploader")
  batchCreator ResultsBatch[] @relation("BatchCreator")

  @@map("admin_users")
}

model AdminPermission {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  resource    String   @db.VarChar(100) // مثل: news, programs, applications, registration
  action      String   @db.VarChar(50)  // مثل: create, read, update, delete, manage
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  users       AdminUserPermission[]

  @@map("admin_permissions")
}

model AdminUserPermission {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  admin_user_id String   @map("admin_user_id") @db.Uuid
  permission_id String   @map("permission_id") @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  admin_user    AdminUser       @relation(fields: [admin_user_id], references: [id], onDelete: Cascade)
  permission    AdminPermission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([admin_user_id, permission_id])
  @@map("admin_user_permissions")
}

model AdminPage {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code      String   @unique @db.VarChar(50)
  nameAr    String   @map("name_ar") @db.VarChar(200)
  nameEn    String?  @map("name_en") @db.VarChar(200)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  permissions AdminPagePermission[]

  @@map("admin_pages")
}

model AdminPagePermission {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  admin_user_id String   @map("admin_user_id") @db.Uuid
  page_id       String   @map("page_id") @db.Uuid
  can_access    Boolean  @default(false) @map("can_access")
  can_view      Boolean  @default(false) @map("can_view")
  can_create    Boolean  @default(false) @map("can_create")
  can_edit      Boolean  @default(false) @map("can_edit")
  can_delete    Boolean  @default(false) @map("can_delete")
  can_upload    Boolean  @default(false) @map("can_upload")
  can_export    Boolean  @default(false) @map("can_export")
  can_publish   Boolean  @default(false) @map("can_publish")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  admin_user    AdminUser @relation(fields: [admin_user_id], references: [id], onDelete: Cascade)
  page          AdminPage @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@unique([admin_user_id, page_id])
  @@map("admin_page_permissions")
}

model Media {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  filename   String   @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(120)
  size       Int
  data       Bytes
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  newsCoverFor      News[] @relation("NewsCoverImage")
  newsSecondaryFor  News[] @relation("NewsSecondaryImage")
  newsSecondary2For News[] @relation("NewsSecondaryImage2")
  deptFeeCardFor    DepartmentFee[] @relation("DeptFeeCardImage")
  tuitionPdfFor     TuitionPdf[]
  personalPhotoFor  RegistrationDocument[] @relation("PersonalPhoto")
  studentIdFrontFor RegistrationDocument[] @relation("StudentIdFront")
  studentIdBackFor  RegistrationDocument[] @relation("StudentIdBack")
  fatherIdFrontFor  RegistrationDocument[] @relation("FatherIdFront")
  fatherIdBackFor   RegistrationDocument[] @relation("FatherIdBack")
  motherIdFrontFor  RegistrationDocument[] @relation("MotherIdFront")
  motherIdBackFor   RegistrationDocument[] @relation("MotherIdBack")
  residenceCardFrontFor RegistrationDocument[] @relation("ResidenceCardFront")
  residenceCardBackFor  RegistrationDocument[] @relation("ResidenceCardBack")
  highSchoolCertificateFor RegistrationDocument[] @relation("HighSchoolCertificate")
  highSchoolCertificateBackFor RegistrationDocument[] @relation("HighSchoolCertificateBack")
  barcodeDocumentFor RegistrationDocument[] @relation("BarcodeDocument")

  @@map("media")
}

model News {
  id                String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title             String        @db.VarChar(250)
  titleEn           String?       @map("title_en") @db.VarChar(250)
  slug              String?       @unique @db.VarChar(250)
  excerpt           String?       @db.VarChar(500)
  excerptEn         String?       @map("excerpt_en") @db.VarChar(500)
  content           String
  contentEn         String?       @map("content_en") @db.Text
  category          NewsCategory?
  published         Boolean       @default(false) @map("is_published")
  publishedAt       DateTime?     @map("publish_date") @db.Timestamptz(6)
  featured          Boolean       @default(false)
  coverImageId      String?       @map("cover_image_id") @db.Uuid
  coverImage        Media?        @relation("NewsCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  secondaryImageId  String?       @map("secondary_image_id") @db.Uuid
  secondaryImage    Media?        @relation("NewsSecondaryImage", fields: [secondaryImageId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  secondaryImage2Id String?       @map("secondary_image2_id") @db.Uuid
  secondaryImage2   Media?        @relation("NewsSecondaryImage2", fields: [secondaryImage2Id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  // الحفاظ على العمود الموجود حالياً (اختياري)
  createdById String? @map("created_by") @db.Uuid
  createdBy   users?  @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([published, publishedAt])
  @@index([category])
  @@map("news")
}

model sessions {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id             String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  username       String     @unique @db.VarChar(50)
  email          String     @unique @db.VarChar(120)
  password_hash  String?
  password_plain String?
  role           String     @default("user") @db.VarChar(20)
  is_active      Boolean    @default(true)
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @default(now()) @db.Timestamptz(6)
  news           News[]
  sessions       sessions[]
}

model visitor_count {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  count      BigInt   @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model TickerItem {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  text       String   @db.VarChar(400)
  textEn     String?  @map("text_en") @db.VarChar(400)
  link       String?  @db.VarChar(500)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("ticker_items")
}

model DepartmentFee {
  id                   String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  department_slug      String           @unique @map("department_slug") @db.VarChar(120)
  display_name         String?          @map("display_name") @db.VarChar(250)
  display_name_en      String?          @map("display_name_en") @db.VarChar(250)
  categories           Json             @default("[]") @map("categories")
  cardImageId          String?          @map("card_image_id") @db.Uuid
  brief                String?          @db.Text
  brief_en             String?          @map("brief_en") @db.Text
  morning_price        Decimal          @map("morning_price") @db.Decimal(14, 0)
  evening_price        Decimal          @map("evening_price") @db.Decimal(14, 0)
  currency             String           @default("د.ع") @db.VarChar(20)
  registration_fee     Decimal?         @map("registration_fee") @db.Decimal(14, 0)
  extra_fees           String?          @map("extra_fees") @db.Text
  extra_fees_en        String?          @map("extra_fees_en") @db.Text
  fees_notes           String?          @map("fees_notes") @db.Text
  fees_notes_en        String?          @map("fees_notes_en") @db.Text
  morning_min_gpa      Decimal          @map("morning_min_gpa") @db.Decimal(5, 2)
  evening_min_gpa      Decimal          @map("evening_min_gpa") @db.Decimal(5, 2)
  admission_notes      String?          @map("admission_notes") @db.Text
  admission_notes_en   String?          @map("admission_notes_en") @db.Text
  show_apply_button    Boolean          @default(true) @map("show_apply_button")
  apply_types          Json             @default("[]") @map("apply_types")
  apply_url            String?          @map("apply_url") @db.Text
  apply_url_external   String?          @map("apply_url_external") @db.Text
  apply_url_whatsapp  String?          @map("apply_url_whatsapp") @db.Text
  apply_button_text    String?          @map("apply_button_text") @db.VarChar(120)
  apply_button_text_en String?          @map("apply_button_text_en") @db.VarChar(120)
  required_docs        Json?            @map("required_docs")
  application_start    DateTime?        @map("application_start") @db.Date
  application_end      DateTime?        @map("application_end") @db.Date
  featured             Boolean          @default(false)
  sort_order           Int              @default(0) @map("sort_order")
  is_active            Boolean          @default(true) @map("is_active")
  created_at           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cardImage           Media?           @relation("DeptFeeCardImage", fields: [cardImageId], references: [id], onDelete: SetNull)

  @@index([is_active, featured, sort_order])
  @@map("department_fees")
}

model TuitionPdf {
  id        Int      @id @default(autoincrement())
  mediaId   String   @map("media_id") @db.Uuid
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("tuition_pdf")
}

model SocialLink {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  platform  String   @unique @db.VarChar(50)
  url       String?  @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("social_links")
}

model Program {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug              String    @unique @db.VarChar(120)
  nameAr            String?   @map("name_ar") @db.VarChar(250)
  nameEn            String?   @map("name_en") @db.VarChar(250)
  briefAr           String?   @map("brief_ar") @db.Text
  briefEn           String?   @map("brief_en") @db.Text
  lecturesTables    Json      @default("[]") @map("lectures_tables")
  examsTables       Json      @default("[]") @map("exams_tables")
  studyShift        String   @map("study_shift") @db.VarChar(20)
  image1Id          String?   @map("image_1_id") @db.Uuid
  image2Id          String?   @map("image_2_id") @db.Uuid
  image3Id          String?   @map("image_3_id") @db.Uuid
  image4Id          String?   @map("image_4_id") @db.Uuid
  sortOrder         Int      @default(0) @map("sort_order")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("programs")
}

model RegistrationDocument {
  id                        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  full_name                 String   @map("full_name") @db.VarChar(200)
  department                String   @db.VarChar(200)
  stage                     String   @db.VarChar(50)
  study_type                String   @map("study_type") @db.VarChar(20)
  phone                     String   @db.VarChar(20)
  personal_photo_id         String?  @map("personal_photo_id") @db.Uuid
  student_id_front_id       String?  @map("student_id_front_id") @db.Uuid
  student_id_back_id        String?  @map("student_id_back_id") @db.Uuid
  father_id_front_id        String?  @map("father_id_front_id") @db.Uuid
  father_id_back_id         String?  @map("father_id_back_id") @db.Uuid
  mother_id_front_id        String?  @map("mother_id_front_id") @db.Uuid
  mother_id_back_id         String?  @map("mother_id_back_id") @db.Uuid
  residence_card_front_id   String?  @map("residence_card_front_id") @db.Uuid
  residence_card_back_id    String?  @map("residence_card_back_id") @db.Uuid
  high_school_certificate_id String? @map("high_school_certificate_id") @db.Uuid
  high_school_certificate_back_id String? @map("high_school_certificate_back_id") @db.Uuid
  barcode_document_id       String?  @map("barcode_document_id") @db.Uuid
  created_at                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  personal_photo         Media? @relation("PersonalPhoto", fields: [personal_photo_id], references: [id], onDelete: SetNull)
  student_id_front      Media? @relation("StudentIdFront", fields: [student_id_front_id], references: [id], onDelete: SetNull)
  student_id_back       Media? @relation("StudentIdBack", fields: [student_id_back_id], references: [id], onDelete: SetNull)
  father_id_front       Media? @relation("FatherIdFront", fields: [father_id_front_id], references: [id], onDelete: SetNull)
  father_id_back        Media? @relation("FatherIdBack", fields: [father_id_back_id], references: [id], onDelete: SetNull)
  mother_id_front       Media? @relation("MotherIdFront", fields: [mother_id_front_id], references: [id], onDelete: SetNull)
  mother_id_back        Media? @relation("MotherIdBack", fields: [mother_id_back_id], references: [id], onDelete: SetNull)
  residence_card_front  Media? @relation("ResidenceCardFront", fields: [residence_card_front_id], references: [id], onDelete: SetNull)
  residence_card_back   Media? @relation("ResidenceCardBack", fields: [residence_card_back_id], references: [id], onDelete: SetNull)
  high_school_certificate Media? @relation("HighSchoolCertificate", fields: [high_school_certificate_id], references: [id], onDelete: SetNull)
  high_school_certificate_back Media? @relation("HighSchoolCertificateBack", fields: [high_school_certificate_back_id], references: [id], onDelete: SetNull)
  barcode_document      Media? @relation("BarcodeDocument", fields: [barcode_document_id], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@map("registration_documents")
}

model Student {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  student_id            String   @unique @map("student_id") @db.VarChar(50)
  full_name             String   @map("full_name") @db.VarChar(200)
  department_code       String   @map("department_code") @db.VarChar(50)
  stage                 String   @db.VarChar(50)
  study_type            String   @map("study_type") @db.VarChar(20) // صباحي/مسائي
  academic_year         String   @map("academic_year") @db.VarChar(20)
  semester              String   @db.VarChar(50)
  financial_clearance    Boolean  @default(false) @map("financial_clearance")
  clearance_updated_at   DateTime? @map("clearance_updated_at") @db.Timestamptz(6)
  clearance_updated_by   String?  @map("clearance_updated_by") @db.Uuid
  created_at            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updated_by            String?  @map("updated_by") @db.Uuid

  results Result[]
  user    StudentUser?
  updater AdminUser? @relation("StudentUpdater", fields: [updated_by], references: [id], onDelete: SetNull)
  clearanceUpdater AdminUser? @relation("StudentClearanceUpdater", fields: [clearance_updated_by], references: [id], onDelete: SetNull)

  @@index([student_id])
  @@index([department_code, stage, study_type, academic_year, semester])
  @@index([financial_clearance])
  @@map("students")
}

model Result {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  student_id        String   @map("student_id") @db.VarChar(50)
  department_code   String   @map("department_code") @db.VarChar(50)
  academic_year     String   @map("academic_year") @db.VarChar(20)
  semester          String   @db.VarChar(50)
  stage             String   @db.VarChar(50)
  study_type        String   @map("study_type") @db.VarChar(20) // صباحي/مسائي
  attempt           String   @db.VarChar(50)
  summary_json      Json     @map("summary_json") // المجموع، المعدل، التقييم، النتيجة النهائية، أعلى درجة
  subjects_json     Json     @map("subjects_json") // array of subjects with units and attempt values
  raw_row_json      Json?    @map("raw_row_json") // optional: full row data
  uploaded_batch_id String?  @map("uploaded_batch_id") @db.Uuid
  uploaded_at       DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  uploaded_by       String?  @map("uploaded_by") @db.Uuid

  student         Student      @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  batch           ResultsBatch? @relation(fields: [uploaded_batch_id], references: [id], onDelete: SetNull)
  uploader        AdminUser?   @relation("ResultUploader", fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@unique([student_id, department_code, stage, study_type, academic_year, semester, attempt])
  @@index([student_id])
  @@index([department_code, academic_year, semester, stage, study_type, attempt])
  @@index([uploaded_batch_id])
  @@map("results")
}

model ResultsBatch {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  department_code    String   @map("department_code") @db.VarChar(50)
  academic_year      String   @map("academic_year") @db.VarChar(20)
  semester           String   @db.VarChar(50)
  stage              String   @db.VarChar(50)
  study_type         String   @map("study_type") @db.VarChar(20) // صباحي/مسائي
  attempt            String   @db.VarChar(50)
  file_name          String   @map("file_name") @db.VarChar(255)
  file_hash          String?  @map("file_hash") @db.VarChar(64) // SHA-256 hash
  rows_count         Int      @map("rows_count")
  imported_count     Int      @default(0) @map("imported_count")
  skipped_count      Int      @default(0) @map("skipped_count")
  meta_subjects_json Json?    @map("meta_subjects_json") // detected subjects + units + mapping
  errors_json        Json?    @map("errors_json")
  created_at         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  created_by         String?  @map("created_by") @db.Uuid

  results Result[]
  creator AdminUser? @relation("BatchCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([department_code, academic_year, semester, stage, study_type, attempt])
  @@index([created_at])
  @@index([file_hash])
  @@map("results_batches")
}

model StudentUser {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  username            String    @unique @db.VarChar(100)
  password_hash       String    @map("password_hash")
  student_id          String    @unique @map("student_id") @db.VarChar(50)
  is_active           Boolean   @default(true) @map("is_active")
  must_change_password Boolean  @default(false) @map("must_change_password")
  last_login_at       DateTime? @map("last_login_at") @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  student Student @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@index([student_id])
  @@index([username])
  @@map("student_users")
}
